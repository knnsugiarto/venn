# Copy to .env.local for local development. Never commit real keys.
# On Vercel: Project > Settings > Environment Variables.

# Claude API key from https://platform.claude.com (server-side only).
# Leave empty to run in demo mode (labelled "not Claude").
ANTHROPIC_API_KEY=

# Optional: override the model (default claude-haiku-5-5).
VENN_MODEL=
